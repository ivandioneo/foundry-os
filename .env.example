# Foundry — local development environment variables (STORY-003, STORY-004).
# Copy to `.env` and adjust as needed: `cp .env.example .env`
# `.env` is gitignored; never commit real secrets.
#
# The POSTGRES_*/MINIO_*/MAILPIT_* variables configure the Docker Compose services
# in docker-compose.yml. Storage-client and mail-client wiring are introduced by
# later stories, each defining its own validated environment schema at the
# application boundary (CLAUDE.md §12 — Zod).

# --- PostgreSQL (pgvector-ready) ---
POSTGRES_USER=foundry
POSTGRES_PASSWORD=foundry
POSTGRES_DB=foundry
POSTGRES_PORT=5432

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=foundry
MINIO_ROOT_PASSWORD=foundry123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Mailpit (local SMTP + web UI for email testing) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Prisma (STORY-004) ---
# Must match the POSTGRES_* values above. Read via prisma.config.ts and
# prisma/schema.prisma's env("DATABASE_URL") — never hardcoded.
DATABASE_URL="postgresql://foundry:foundry@localhost:5432/foundry?schema=public"
