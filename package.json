{
  "name": "foundry",
  "private": true,
  "version": "0.0.0",
  "description": "Foundry — institutional-memory OS for discovering, validating, building, and managing software companies. Repository foundation only.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.23.1 <23",
    "pnpm": ">=9"
  },
  "prettier": "@foundry/config/prettier",
  "scripts": {
    "dev": "pnpm --filter @foundry/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@foundry/config": "workspace:*",
    "@next/eslint-plugin-next": "^15.1.3",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0"
  }
}
